# Copy to .env: cp .env.example .env && ./scripts/gen-env.sh
# (gen-env.sh fills every blank secret below; only set OPENROUTER_KEY yourself)

OPENROUTER_KEY=sk-or-v1-...your-key...

# Postgres superuser password (retail-postgres) and the read-only role Wren uses
RETAIL_DB_PASSWORD=
WREN_RO_PASSWORD=

# SearXNG session secret
SEARXNG_SECRET=

# LibreChat crypto: CREDS_KEY = 64 hex chars, CREDS_IV = 32 hex chars, JWT secrets = 64 hex chars
CREDS_KEY=
CREDS_IV=
JWT_SECRET=
JWT_REFRESH_SECRET=
